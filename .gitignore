# 运行时数据与密钥（严禁提交）
data/*
!data/.gitkeep
*.db
*.sqlite
*.sqlite3
*.log
*.jsonl
.secret
token
config.json
.env
env.*
*.pem
*.key
*.jks
*.keystore

# 大型二进制镜像（改用 Releases 分发或本地构建脚本生成）
*.img
*.img.gz
*.iso
*.iso.*
*.tgz
*.tar.gz

# 构建产物 / 缓存
__pycache__/
*.pyc
.venv/
venv/
build/
dist/
*.class
*.dex

# 编辑器 / 系统
.DS_Store
Thumbs.db
.idea/

# 编译产物：仓库里保留少量（BOOTAA64.EFI / kernel.elf / 若干 .o）供直接体验，
# 见 README「诚实的边界」；此后新增的一律不再纳入，源码以 build.sh 为准
*.o
*.elf
*.a
*.bin
